<!DOCTYPE html>
<html lang="ja" data-server-theme="<%= current_user&.theme || "system" %>">
  <head>
    <title><%= content_for(:title) || "Jozu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Jozu">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#fafafa">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Apply the saved theme before first paint to avoid a light flash. %>
    <script>
      try {
        var stored = localStorage.getItem("jozu-theme");
        var server = document.documentElement.dataset.serverTheme || "system";
        var theme = stored || server || "system";
        var dark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) {
          document.documentElement.classList.add("dark");
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#09090b");
        }
      } catch (e) {}
    </script>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind compiled to app/assets/builds/tailwind.css (see app/assets/tailwind/application.css) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100" data-controller="theme">
    <nav class="border-b border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
      <div class="mx-auto max-w-2xl px-4 py-3 flex items-center justify-between">
        <%= link_to "Jozu", root_path, class: "text-lg font-bold tracking-tight px-1 py-1" %>
        <div class="flex items-center gap-1 text-sm">
          <%= link_to "Today", root_path, class: "rounded-lg px-3 py-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100" %>
          <%= link_to "Progress", progress_path, class: "rounded-lg px-3 py-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100" %>
          <%= link_to "Settings", settings_path, class: "rounded-lg px-3 py-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100" %>
          <button type="button"
                  data-action="click->theme#toggle"
                  aria-label="Toggle dark mode"
                  title="Toggle dark mode"
                  class="ml-1 rounded-lg px-3 py-2 text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
            <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg class="block h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 12 21.75a9.753 9.753 0 0 0 9.752-6.748Z" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-2xl px-4 py-6 pb-12">
      <%= yield %>
    </main>
  </body>
</html>
