<% content_for :title, "Settings — Jozu" %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold">Settings</h1>

  <% if flash[:notice] %>
    <p class="rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800 dark:bg-green-950 dark:text-green-200"><%= flash[:notice] %></p>
  <% end %>

  <%= form_with url: settings_path, method: :patch, class: "space-y-6" do |form| %>
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Appearance</h2>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Choose how Jozu looks on this device. System follows your OS setting.</p>
      <div class="mt-4 grid grid-cols-3 gap-2" role="radiogroup" aria-label="Theme">
        <% { "system" => "System", "light" => "Light", "dark" => "Dark" }.each do |value, label| %>
          <label class="cursor-pointer rounded-xl border-2 border-zinc-300 bg-white px-3 py-3 text-center text-sm font-semibold text-zinc-700 transition hover:bg-zinc-100 has-checked:border-blue-500 has-checked:bg-blue-50 has-checked:text-blue-900 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:has-checked:border-blue-400 dark:has-checked:bg-blue-950 dark:has-checked:text-blue-100">
            <%= radio_button_tag :theme, value, current_user.theme == value, class: "sr-only", data: { action: "change->theme#choose" } %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <label class="flex items-start gap-3">
        <%= check_box_tag :skip_number_kanji, "1", current_user.skip_number_kanji?, class: "mt-1 h-5 w-5 rounded border-zinc-300 dark:border-zinc-600 dark:bg-zinc-800" %>
        <span>
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">Skip number kanji</span>
          <span class="mt-1 block text-sm text-zinc-500 dark:text-zinc-400">
            Don't drill 一二三四五六七八九十百千万億 etc. (useful if you already know them).
            Already-learned number kanji are paused, not deleted.
          </span>
        </span>
      </label>
    </div>

    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <label class="flex items-start gap-3">
        <%= check_box_tag :practice_mode, "1", current_user.practice_mode?, class: "mt-1 h-5 w-5 rounded border-zinc-300 dark:border-zinc-600 dark:bg-zinc-800" %>
        <span>
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">Practice mode</span>
          <span class="mt-1 block text-sm text-zinc-500 dark:text-zinc-400">
            Ignore the daily new-kanji limit so you can start a new session any time —
            useful for testing.
          </span>
        </span>
      </label>
    </div>

    <%= form.submit "Save", class: "w-full rounded-xl bg-blue-600 px-4 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-blue-700 active:bg-blue-800 dark:bg-blue-500 dark:hover:bg-blue-400" %>
  <% end %>
</div>
