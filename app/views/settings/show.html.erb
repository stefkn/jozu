<% content_for :title, "Settings — Jozu" %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold">Settings</h1>

  <% if flash[:notice] %>
    <p class="rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800"><%= flash[:notice] %></p>
  <% end %>

  <%= form_with url: settings_path, method: :patch, class: "space-y-6" do |form| %>
    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
      <label class="flex items-start gap-3">
        <%= check_box_tag :skip_number_kanji, "1", current_user.skip_number_kanji?, class: "mt-1 h-5 w-5 rounded border-zinc-300" %>
        <span>
          <span class="font-semibold text-zinc-900">Skip number kanji</span>
          <span class="mt-1 block text-sm text-zinc-500">
            Don't drill 一二三四五六七八九十百千万億 etc. (useful if you already know them).
            Already-learned number kanji are paused, not deleted.
          </span>
        </span>
      </label>
    </div>

    <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
      <label class="flex items-start gap-3">
        <%= check_box_tag :practice_mode, "1", current_user.practice_mode?, class: "mt-1 h-5 w-5 rounded border-zinc-300" %>
        <span>
          <span class="font-semibold text-zinc-900">Practice mode</span>
          <span class="mt-1 block text-sm text-zinc-500">
            Ignore the daily new-kanji limit so you can start a new session any time —
            useful for testing.
          </span>
        </span>
      </label>
    </div>

    <%= form.submit "Save", class: "w-full rounded-xl bg-blue-600 px-4 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-blue-700 active:bg-blue-800" %>
  <% end %>
</div>