<turbo-frame id="question">
  <div class="space-y-6 text-center">
    <div class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-sm">
      <h2 class="text-xl font-bold">Session complete</h2>

      <dl class="mt-4 grid grid-cols-2 gap-4">
        <div>
          <dt class="text-3xl font-bold text-green-600"><%= tally.where(correct: true).count %></dt>
          <dd class="mt-1 text-xs text-zinc-500">correct</dd>
        </div>
        <div>
          <dt class="text-3xl font-bold text-red-500"><%= tally.where(correct: false).count %></dt>
          <dd class="mt-1 text-xs text-zinc-500">incorrect</dd>
        </div>
      </dl>

      <%= link_to "Done", root_path, class: "mt-6 block w-full rounded-xl bg-blue-600 px-4 py-4 text-center text-lg font-semibold text-white shadow-sm transition hover:bg-blue-700 active:bg-blue-800" %>
    </div>
  </div>
</turbo-frame>