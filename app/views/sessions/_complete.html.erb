<turbo-frame id="question">
  <div class="space-y-6 text-center">
    <div class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <h2 class="text-xl font-bold">Session complete</h2>

      <dl class="mt-4 grid grid-cols-2 gap-4">
        <div>
          <dt class="text-3xl font-bold text-green-600 dark:text-green-400"><%= tally.where(correct: true).count %></dt>
          <dd class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">correct</dd>
        </div>
        <div>
          <dt class="text-3xl font-bold text-red-500 dark:text-red-400"><%= tally.where(correct: false).count %></dt>
          <dd class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">incorrect</dd>
        </div>
      </dl>

      <%= link_to "Done", root_path, class: "mt-6 block w-full rounded-xl bg-blue-600 px-4 py-4 text-center text-lg font-semibold text-white shadow-sm transition hover:bg-blue-700 active:bg-blue-800 dark:bg-blue-500 dark:hover:bg-blue-400" %>

      <% if current_user.practice_mode? %>
        <%= link_to "Start another session", next_sessions_path, class: "mt-3 block w-full rounded-xl border-2 border-zinc-300 bg-white px-4 py-3 text-center text-sm font-semibold text-zinc-700 shadow-sm transition hover:bg-zinc-100 active:bg-zinc-200 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800 dark:active:bg-zinc-700" %>
      <% end %>
    </div>
  </div>
</turbo-frame>
