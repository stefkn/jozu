<% content_for :title, "Progress — Jozu" %>

<div class="space-y-6">
  <h1 class="text-2xl font-bold">How much can I read?</h1>

  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold text-zinc-500">Most common <%= @progress.total_kanji %> kanji</h2>
      <span class="text-2xl font-bold"><%= @progress.coverage_percent %>%</span>
    </div>

    <div class="mt-3 h-3 w-full overflow-hidden rounded-full bg-zinc-200">
      <div class="h-full rounded-full bg-blue-600" style="width: <%= @progress.coverage_percent %>%"></div>
    </div>

    <dl class="mt-5 grid grid-cols-4 gap-2 text-center">
      <div>
        <dt class="text-2xl font-bold text-green-600"><%= @progress.known %></dt>
        <dd class="text-xs text-zinc-500">Known</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-blue-600"><%= @progress.learning %></dt>
        <dd class="text-xs text-zinc-500">Learning</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-amber-500"><%= @progress.weak %></dt>
        <dd class="text-xs text-zinc-500">Weak</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-zinc-300"><%= @progress.unknown %></dt>
        <dd class="text-xs text-zinc-500">Unknown</dd>
      </div>
    </dl>
  </div>

  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-semibold text-zinc-500">Words unlocked</h2>
    <p class="mt-2 text-3xl font-bold"><%= @progress.words_unlocked %></p>
    <p class="mt-1 text-xs text-zinc-500">words you know well enough to read</p>
  </div>
</div>