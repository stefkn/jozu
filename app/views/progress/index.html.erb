<% content_for :title, "Progress — Jozu" %>

<div class="space-y-6" data-controller="kanji-dialog">
  <h1 class="text-2xl font-bold">How much can I read?</h1>

  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Most common <%= @progress.total_kanji %> kanji</h2>
      <span class="text-2xl font-bold"><%= @progress.coverage_percent %>%</span>
    </div>

    <div class="mt-3 h-3 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-700">
      <div class="h-full rounded-full bg-blue-600 dark:bg-blue-500" style="width: <%= @progress.coverage_percent %>%"></div>
    </div>

    <dl class="mt-5 grid grid-cols-4 gap-2 text-center">
      <div>
        <dt class="text-2xl font-bold text-green-600 dark:text-green-400"><%= @progress.known %></dt>
        <dd class="text-xs text-zinc-500 dark:text-zinc-400">Known</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= @progress.learning %></dt>
        <dd class="text-xs text-zinc-500 dark:text-zinc-400">Learning</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-amber-500 dark:text-amber-400"><%= @progress.weak %></dt>
        <dd class="text-xs text-zinc-500 dark:text-zinc-400">Weak</dd>
      </div>
      <div>
        <dt class="text-2xl font-bold text-zinc-300 dark:text-zinc-600"><%= @progress.unknown %></dt>
        <dd class="text-xs text-zinc-500 dark:text-zinc-400">Unknown</dd>
      </div>
    </dl>
  </div>

  <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <h2 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Words unlocked</h2>
    <p class="mt-2 text-3xl font-bold"><%= @progress.words_unlocked %></p>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">words you know well enough to read</p>
  </div>

  <% if @leeches.any? %>
    <section aria-labelledby="leeches-heading" class="rounded-2xl border border-red-200 bg-white p-6 shadow-sm dark:border-red-900 dark:bg-zinc-900">
      <h2 id="leeches-heading" class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
        Needs attention <span class="ml-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-bold text-red-700 dark:bg-red-950 dark:text-red-300"><%= @leeches.size %></span>
      </h2>
      <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Your most-missed items. Suspend one to stop drilling it, or open its study notes for a refresher.</p>
      <ul id="leeches" class="mt-4 space-y-2">
        <% @leeches.each do |leech| %>
          <li class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 px-3 py-2 dark:border-zinc-700">
            <div class="min-w-0 flex-1">
              <p class="truncate">
                <span class="text-lg font-semibold"><%= leech.label %></span>
                <% if leech.sublabel.present? %>
                  <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= leech.sublabel %></span>
                <% end %>
                <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= leech.meaning %></span>
              </p>
              <p class="mt-0.5 text-xs text-zinc-400 dark:text-zinc-500">
                wrong <%= leech.incorrect %> of <%= leech.seen %> · mastery <%= leech.mastery.round(2) %>
                <% if leech.suspended %><span class="ml-1 font-semibold text-zinc-500 dark:text-zinc-400">· suspended</span><% end %>
              </p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <% if leech.character %>
                <%= link_to "Study notes", progress_kanji_path(leech.character), class: "rounded-lg px-3 py-1.5 text-xs font-semibold text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-blue-950" %>
              <% end %>
              <% if leech.suspended %>
                <%= button_to "Resume", suspension_path(leech.reviewable_id, type: leech.kind), method: :delete, class: "rounded-lg border border-zinc-300 px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 dark:border-zinc-600 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
              <% else %>
                <%= button_to "Suspend", suspensions_path(type: leech.kind, id: leech.reviewable_id), class: "rounded-lg border border-zinc-300 px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 dark:border-zinc-600 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section aria-labelledby="readable-kanji-heading" class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <h2 id="readable-kanji-heading" class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
      Characters you can read <span class="ml-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700 dark:bg-green-950 dark:text-green-300"><%= @progress.known %></span>
    </h2>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Kanji with reliable mastery — you should recognise these in the wild.</p>
    <% if @progress.known_kanji.any? %>
      <ul id="known-kanji" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6">
        <% @progress.known_kanji.each do |item| %>
          <li>
            <a href="<%= progress_kanji_path(item.character) %>"
               data-action="click->kanji-dialog#open"
               class="block rounded-xl border border-green-200 bg-green-50 px-2 py-3 text-center transition hover:border-green-400 hover:bg-green-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-500 dark:border-green-900 dark:bg-green-950 dark:hover:border-green-700 dark:hover:bg-green-900"
               title="<%= item.readings.join(", ") %> · <%= item.meaning_summary %> · mastery <%= item.mastery_score&.round(2) %> · tap for study notes"
               aria-label="<%= item.character %> — <%= item.meaning_summary %> — tap for study notes">
              <div class="text-2xl font-semibold leading-none"><%= item.character %></div>
              <% if item.readings.any? %>
                <div class="mt-1 truncate text-[11px] text-zinc-600 dark:text-zinc-300"><%= item.readings.join("、 ") %></div>
              <% end %>
              <div class="mt-0.5 truncate text-[11px] text-zinc-500 dark:text-zinc-400"><%= item.meaning_summary %></div>
            </a>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">Nothing reliably readable yet — keep going through sessions.</p>
    <% end %>
  </section>

  <section aria-labelledby="learning-kanji-heading" class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <h2 id="learning-kanji-heading" class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
      Characters you're learning <span class="ml-1 rounded-full bg-blue-100 px-2 py-0.5 text-xs font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300"><%= @progress.learning %></span>
    </h2>
    <% if @progress.learning_kanji.any? %>
      <ul id="learning-kanji" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6">
        <% @progress.learning_kanji.each do |item| %>
          <li>
            <a href="<%= progress_kanji_path(item.character) %>"
               data-action="click->kanji-dialog#open"
               class="block rounded-xl border border-blue-200 bg-blue-50 px-2 py-3 text-center transition hover:border-blue-400 hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:border-blue-900 dark:bg-blue-950 dark:hover:border-blue-700 dark:hover:bg-blue-900"
               title="<%= item.readings.join(", ") %> · <%= item.meaning_summary %> · mastery <%= item.mastery_score&.round(2) %> · tap for study notes"
               aria-label="<%= item.character %> — <%= item.meaning_summary %> — tap for study notes">
              <div class="text-2xl font-semibold leading-none"><%= item.character %></div>
              <% if item.readings.any? %>
                <div class="mt-1 truncate text-[11px] text-zinc-600 dark:text-zinc-300"><%= item.readings.join("、 ") %></div>
              <% end %>
              <div class="mt-0.5 truncate text-[11px] text-zinc-500 dark:text-zinc-400"><%= item.meaning_summary %></div>
            </a>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">Nothing in progress right now.</p>
    <% end %>
  </section>

  <section aria-labelledby="weak-kanji-heading" class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <h2 id="weak-kanji-heading" class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
      Weak characters <span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-700 dark:bg-amber-950 dark:text-amber-300"><%= @progress.weak %></span>
    </h2>
    <% if @progress.weak_kanji.any? %>
      <ul id="weak-kanji" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6">
        <% @progress.weak_kanji.each do |item| %>
          <li>
            <a href="<%= progress_kanji_path(item.character) %>"
               data-action="click->kanji-dialog#open"
               class="block rounded-xl border border-amber-200 bg-amber-50 px-2 py-3 text-center transition hover:border-amber-400 hover:bg-amber-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 dark:border-amber-900 dark:bg-amber-950 dark:hover:border-amber-700 dark:hover:bg-amber-900"
               title="<%= item.readings.join(", ") %> · <%= item.meaning_summary %> · mastery <%= item.mastery_score&.round(2) %> · tap for study notes"
               aria-label="<%= item.character %> — <%= item.meaning_summary %> — tap for study notes">
              <div class="text-2xl font-semibold leading-none"><%= item.character %></div>
              <% if item.readings.any? %>
                <div class="mt-1 truncate text-[11px] text-zinc-600 dark:text-zinc-300"><%= item.readings.join("、 ") %></div>
              <% end %>
              <div class="mt-0.5 truncate text-[11px] text-zinc-500 dark:text-zinc-400"><%= item.meaning_summary %></div>
            </a>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">No weak characters — nice.</p>
    <% end %>
  </section>

  <% if @graduated.any? %>
    <details class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <summary class="cursor-pointer text-sm font-semibold text-zinc-500 dark:text-zinc-400">
        Graduated <span class="ml-1 rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"><%= @graduated.size %></span>
      </summary>
      <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Stable, well-known items retired from reviews. Resume one to put it back in the queue.</p>
      <ul id="graduated" class="mt-4 space-y-2">
        <% @graduated.each do |item| %>
          <li class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 px-3 py-2 dark:border-zinc-700">
            <div class="min-w-0 flex-1">
              <p class="truncate">
                <span class="text-lg font-semibold"><%= item.label %></span>
                <% if item.sublabel.present? %>
                  <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= item.sublabel %></span>
                <% end %>
                <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= item.meaning %></span>
              </p>
            </div>
            <%= button_to "Resume reviews", graduation_path(item.reviewable_id, type: item.kind), method: :delete, class: "shrink-0 rounded-lg border border-zinc-300 px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 dark:border-zinc-600 dark:text-zinc-200 dark:hover:bg-zinc-800" %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <details class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <summary class="cursor-pointer text-sm font-semibold text-zinc-500 dark:text-zinc-400">
      Not yet seen <span class="ml-1 rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"><%= @progress.unknown %></span>
    </summary>
    <% if @progress.unknown_kanji.any? %>
      <ul id="unknown-kanji" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6">
        <% @progress.unknown_kanji.each do |item| %>
          <li>
            <a href="<%= progress_kanji_path(item.character) %>"
               data-action="click->kanji-dialog#open"
               class="block rounded-xl border border-zinc-200 px-2 py-3 text-center transition hover:border-zinc-400 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500 dark:hover:bg-zinc-800"
               title="<%= item.readings.join(", ") %> · <%= item.meaning_summary %> · tap for study notes"
               aria-label="<%= item.character %> — <%= item.meaning_summary %> — tap for study notes">
              <div class="text-2xl font-semibold leading-none text-zinc-400 dark:text-zinc-500"><%= item.character %></div>
              <% if item.readings.any? %>
                <div class="mt-1 truncate text-[11px] text-zinc-400 dark:text-zinc-500"><%= item.readings.join("、 ") %></div>
              <% end %>
              <div class="mt-0.5 truncate text-[11px] text-zinc-400 dark:text-zinc-500"><%= item.meaning_summary %></div>
            </a>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">You've seen every tracked kanji.</p>
    <% end %>
  </details>

  <section aria-labelledby="readable-words-heading" class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
    <h2 id="readable-words-heading" class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
      Words you can read <span class="ml-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700 dark:bg-green-950 dark:text-green-300"><%= @progress.readable_words.size %></span>
    </h2>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Vocabulary with mastery high enough to recognise in sentences.</p>
    <% if @progress.readable_words.any? %>
      <ul id="readable-words" class="mt-4 space-y-2">
        <% @progress.readable_words.each do |word| %>
          <li class="flex items-baseline justify-between gap-3 rounded-xl border border-zinc-200 px-3 py-2 dark:border-zinc-700">
            <div class="min-w-0">
              <span class="font-semibold"><%= word.surface %></span>
              <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= word.reading %></span>
            </div>
            <span class="min-w-0 truncate text-sm text-zinc-500 dark:text-zinc-400"><%= word.meaning %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">No words unlocked yet — they appear here once quiz reviews push them over the threshold.</p>
    <% end %>
  </section>

  <% if @progress.learning_words.any? %>
    <details class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900">
      <summary class="cursor-pointer text-sm font-semibold text-zinc-500 dark:text-zinc-400">
        Words you're still learning <span class="ml-1 rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"><%= @progress.learning_words.size %></span>
      </summary>
      <ul id="learning-words" class="mt-4 space-y-2">
        <% @progress.learning_words.each do |word| %>
          <li class="flex items-baseline justify-between gap-3 rounded-xl border border-zinc-200 px-3 py-2 dark:border-zinc-700">
            <div class="min-w-0">
              <span class="font-semibold"><%= word.surface %></span>
              <span class="ml-2 text-sm text-zinc-500 dark:text-zinc-400"><%= word.reading %></span>
            </div>
            <span class="min-w-0 truncate text-sm text-zinc-500 dark:text-zinc-400"><%= word.meaning %></span>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <dialog data-kanji-dialog-target="dialog"
          data-action="click->kanji-dialog#backdrop close->kanji-dialog#clear"
          aria-labelledby="kanji-dialog-heading"
          class="kanji-dialog m-auto w-[calc(100vw-2rem)] max-w-md rounded-2xl border border-zinc-200 bg-zinc-50 p-0 shadow-xl dark:border-zinc-700 dark:bg-zinc-900">
    <div class="flex items-center justify-between border-b border-zinc-200 px-4 py-3 dark:border-zinc-700">
      <p id="kanji-dialog-heading" class="text-xs font-medium uppercase tracking-widest text-zinc-400 dark:text-zinc-500">Study notes</p>
      <button type="button"
              data-action="click->kanji-dialog#close"
              aria-label="Close study notes"
              class="rounded-lg px-3 py-1 text-sm text-zinc-500 hover:bg-zinc-200 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">✕</button>
    </div>
    <div class="max-h-[70vh] overflow-y-auto p-4">
      <div data-kanji-dialog-target="content"></div>
    </div>
    <div class="border-t border-zinc-200 px-4 py-3 text-right dark:border-zinc-700">
      <a data-kanji-dialog-target="fullPageLink" href="<%= progress_path %>" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">Open full page →</a>
    </div>
  </dialog>
</div>
